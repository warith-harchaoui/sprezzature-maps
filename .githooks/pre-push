#!/usr/bin/env bash
# Pre-push gate: block the push on a lint, type or test failure, so a red local
# state never reaches CI. The steps mirror this repository's own workflow, in
# the same order, so "the hook passed" and "CI will pass" mean the same thing.
#
# One-time setup per clone (the repo config already does it here):
#   git config core.hooksPath .githooks
# Bypass, rare and deliberate only:
#   git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# core.hooksPath replaces the global hook directory rather than adding to it,
# and the global one is where git-lfs installs its own pre-push. This repo
# keeps assets in LFS (see .gitattributes), so the relay has to be explicit:
# without it, pushing uploads pointer files and leaves the objects behind.
if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@"
fi

echo "[pre-push] ruff..."
ruff check sprezzature_maps scripts tests || { echo "[pre-push] ruff failed - push aborted."; exit 1; }

# mypy, with one known condition tolerated and nothing else.
#
# numpy >= 2.3 ships stubs written with PEP 695 `type` statements, which mypy
# accepts only from python_version 3.12; mypy.ini pins 3.10 on purpose, to
# keep checking against the oldest Python this package supports. numpy is not
# imported here -- it arrives through pydantic's type graph -- so on a machine
# that happens to have it, mypy stops inside that stub having checked none of
# our code. CI installs no numpy and is green. The long form is in mypy.ini.
#
# Aborting on it made this hook unpassable on any developer machine with numpy
# installed, which is most of them. An unpassable hook teaches `--no-verify`,
# and that skips ruff and the tests as well, so the gate was costing more than
# it caught.
#
# The rule is the narrow one: tolerate a failure only when every error mypy
# reported lies outside this repository. In-repo errors are relative paths and
# third-party ones are absolute, so one error in our own files still stops the
# push -- as does a failure that reports no errors at all, which is a mypy
# that broke rather than a stub that did.
mypy_gate() {
  local out errs rc=0
  out=$(mypy "$@" 2>&1) || rc=$?
  [ "$rc" -eq 0 ] && return 0
  errs=$(printf '%s\n' "$out" | grep ': error:' || true)
  if [ -z "$errs" ] || printf '%s\n' "$errs" | grep -qv '^/'; then
    printf '%s\n' "$out"
    return 1
  fi
  echo "[pre-push] mypy stopped inside a third-party stub having checked none"
  echo "           of this package, and reported nothing in our own files."
  echo "           Known condition, see mypy.ini. Treated as a skip, not a pass."
  return 0
}

echo "[pre-push] mypy..."
mypy_gate sprezzature_maps && mypy_gate scripts || { echo "[pre-push] mypy failed - push aborted."; exit 1; }

# Same command as CI, which also runs `-n auto`: 15m43s serially became 2m32s
# here, and the hook is what a contributor waits on before every single push.
# Each worker holds several GB (the measurements are in the comment above the
# Tests step of .github/workflows/ci.yml); if this line ever OOMs on a smaller
# machine, drop to `-n 2`.
echo "[pre-push] pytest (-n auto)..."
python3 -m pytest -q -n auto || { echo "[pre-push] pytest failed - push aborted."; exit 1; }

# Every module, rather than a hand-written list. Two such lists existed, here
# and in the CI workflow, and they had already drifted apart by a file; a
# module whose doctests nobody runs is a worked example nobody checks.
#
# The loop is written out rather than piped into `|| { ... }`: that form takes
# the exit status of the *last* iteration, and `set -e` is suppressed on the
# left of `||`, so a failure in any file but the last one passed silently.
echo "[pre-push] doctests..."
for f in scripts/*.py; do
  if ! python3 -m doctest "$f"; then
    echo "[pre-push] doctests failed in $f - push aborted."
    exit 1
  fi
done

# The package's own modules, as CI's "Doctests (the package)" step runs them:
# through pytest, because `python -m doctest sprezzature_maps/api.py` imports
# the file as a top-level module and its relative imports fail. Until
# 2026-11-05 this hook skipped them, so a stale worked example in
# `sprezzature_maps/` passed here and failed on the runner.
echo "[pre-push] doctests (the package)..."
python3 -m pytest -q --doctest-modules sprezzature_maps || { echo "[pre-push] package doctests failed - push aborted."; exit 1; }

echo "[pre-push] all green - pushing."
