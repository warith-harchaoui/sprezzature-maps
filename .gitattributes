assets/geo/*.png filter=lfs diff=lfs merge=lfs -text
# Compiled doc binaries (doc/CARTOGRAPHY.pdf via xelatex/biber): fully
# regenerated on every restructure rather than incrementally diffed, and
# a compiled document's own binary format (embedded fonts, timestamps)
# means two builds of the "same" content rarely delta-compress well even
# when git tries. Same LFS rationale as the raster geo assets above, not
# a size threshold (assets/logo.png stays plain git at nearly 3MB because
# it is a static asset that essentially never changes; doc/CARTOGRAPHY.pdf
# is print-resolution and 12MB-plus precisely because it does churn).
*.pdf filter=lfs diff=lfs merge=lfs -text
# doc/CARTOGRAPHY.tex's own print-resolution figures: the same wholesale-
# regenerated-composite-render pattern as the elevation pyramid above, not
# a size threshold (individual files range 56KB-3MB).
doc/img/*.png filter=lfs diff=lfs merge=lfs -text
